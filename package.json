{
  "name": "ai-playwright-testing",
  "version": "1.0.0",
  "description": "AI-assisted web testing with Playwright and Claude: natural-language steps, self-healing locators, visual assertions.",
  "scripts": {
    "test": "playwright test",
    "test:baseline": "playwright test --project=baseline",
    "test:offline": "playwright test --project=offline",
    "test:ai": "playwright test --project=ai",
    "typecheck": "tsc -p .",
    "report": "playwright show-report"
  },
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "dotenv": "^18.0.8",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.137.0",
    "zod": "^4.6.7"
  },
  "keywords": [
    "playwright",
    "ai",
    "testing",
    "claude",
    "self-healing",
    "qa"
  ]
}
